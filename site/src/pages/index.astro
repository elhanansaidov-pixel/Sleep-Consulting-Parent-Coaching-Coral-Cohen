---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Hero from '../components/Hero.astro';
import Sections from '../components/Sections.astro';
import Thread from '../components/Thread.astro';
import Questionnaire from '../components/Questionnaire.astro';
---
<Base
  title="קורל כהן | ייעוץ שינה והדרכת הורים — ליווי אישי למשפחות"
  description="תהליך ליווי אישי של כשמונה שבועות לשיפור השינה של הילדים, עם תוכנית מותאמת, משוב יומי על יומן שינה ושיחה שבועית. מלאו שאלון התאמה קצר."
>
  <Chrome part="header" />
  <main id="main">
    <Hero />
    <Sections />
    <Thread />
    <Questionnaire />
  </main>
  <Chrome part="footer" />
  <script>
    import '../scripts/motion';
  </script>
</Base>
