---
import '@fontsource/ibm-plex-sans-hebrew/hebrew-300.css';
import '@fontsource/ibm-plex-sans-hebrew/hebrew-400.css';
import '@fontsource/ibm-plex-sans-hebrew/hebrew-500.css';
import '@fontsource/ibm-plex-sans-hebrew/latin-400.css';
import App from '../../admin/App';
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#1e2230" />
    <title>CRM | קורל כהן</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body class="crm">
    <noscript>יש להפעיל JavaScript כדי להשתמש במערכת.</noscript>
    <App client:only="react" />
  </body>
</html>
