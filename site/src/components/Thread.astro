---
/** The "thread" from the logo: a hand-drawn line ending in a small heart, drawn on scroll. */
interface Props { tone?: 'dark' | 'light'; }
const { tone = 'dark' } = Astro.props;
---
<div class={`thread thread--${tone}`} aria-hidden="true">
  <svg viewBox="0 0 1200 60" preserveAspectRatio="none" fill="none">
    <path data-thread
      d="M1200 34 C 1040 34, 960 30, 820 33 S 560 40, 420 32 S 210 26, 120 32 C 80 34, 62 34, 52 30 C 40 25, 34 14, 42 9 C 49 5, 56 10, 56 16 C 56 10, 63 5, 70 9 C 78 14, 72 25, 60 30 C 54 33, 40 36, 0 35"
      stroke="currentColor" stroke-width="1.6" stroke-linecap="round" vector-effect="non-scaling-stroke" />
  </svg>
</div>
<style>
  .thread { width: min(100% - 2rem, 72rem); margin-inline: auto; height: 48px; }
  .thread--dark { color: var(--stone); }
  .thread--light { color: rgba(254, 250, 244, 0.5); }
  .thread svg { width: 100%; height: 100%; overflow: visible; }
</style>
