---
/**
 * Accessibility menu (self-built, no third-party overlay): text size, contrast, grayscale,
 * link highlighting, readable spacing, stop motion, large cursor. Preferences persist in
 * localStorage (per device) and are applied before paint by the inline script in Base.astro.
 */
const toggles = [
  { key: 'contrast', label: 'ניגודיות גבוהה' },
  { key: 'gray', label: 'גווני אפור' },
  { key: 'links', label: 'הדגשת קישורים' },
  { key: 'spacing', label: 'ריווח טקסט' },
  { key: 'still', label: 'עצירת אנימציות' },
  { key: 'cursor', label: 'סמן גדול' },
] as const;
---
<div class="a11y" data-a11y>
  <button class="a11y__btn" type="button" aria-expanded="false" aria-controls="a11y-panel" data-a11y-open>
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
      <circle cx="12" cy="4" r="2" fill="currentColor" />
      <path d="M4 7.5c2.6.8 5.3 1.2 8 1.2s5.4-.4 8-1.2M12 8.7v5.3m0 0-3 7m3-7 3 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span class="sr-only">תפריט נגישות</span>
  </button>

  <div class="a11y__panel" id="a11y-panel" role="dialog" aria-labelledby="a11y-title" hidden data-a11y-panel>
    <div class="a11y__head">
      <h2 id="a11y-title" class="a11y__title">נגישות</h2>
      <button type="button" class="a11y__close" data-a11y-close aria-label="סגירת תפריט הנגישות">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </div>

    <div class="a11y__size" role="group" aria-labelledby="a11y-size-l">
      <span id="a11y-size-l">גודל טקסט</span>
      <div class="a11y__sizebtns">
        <button type="button" data-a11y-size="-1" aria-label="הקטנת טקסט">א-</button>
        <output data-a11y-size-val aria-live="polite">100%</output>
        <button type="button" data-a11y-size="1" aria-label="הגדלת טקסט">א+</button>
      </div>
    </div>

    <ul class="a11y__list">
      {toggles.map((t) => (
        <li><button type="button" class="a11y__opt" aria-pressed="false" data-a11y-toggle={t.key}>{t.label}</button></li>
      ))}
    </ul>

    <div class="a11y__foot">
      <button type="button" class="a11y__reset" data-a11y-reset>איפוס הגדרות</button>
      <a href="/accessibility">הצהרת נגישות</a>
    </div>
  </div>
</div>

<style>
  .a11y { position: fixed; z-index: 70; inset-inline-end: 1.1rem; bottom: 1.1rem; }
  .a11y__btn {
    width: 3.25rem; height: 3.25rem; border-radius: 50%; border: 2px solid var(--cream); cursor: pointer;
    display: grid; place-items: center; background: #1f4e8c; color: #fff;
    box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.45);
  }
  .a11y__btn:focus-visible { outline: 3px solid var(--glow); outline-offset: 3px; }
  .a11y__panel {
    position: absolute; inset-inline-end: 0; bottom: calc(100% + 0.75rem);
    width: min(19rem, calc(100vw - 2rem)); max-height: calc(100svh - 7rem); overflow: auto;
    background: #fff; color: #1b1b1b; border: 1px solid #c9c2b6; border-radius: 10px;
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.45); padding: 1rem; font-size: 1rem;
  }
  .a11y__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; }
  .a11y__title { font-size: 1.15rem; font-weight: 600; margin: 0; }
  .a11y__close { background: none; border: 0; color: inherit; cursor: pointer; padding: 0.35rem; border-radius: 6px; display: grid; }
  .a11y__size { display: flex; justify-content: space-between; align-items: center; padding: 0.6rem 0; border-block: 1px solid #e4ded3; }
  .a11y__sizebtns { display: flex; align-items: center; gap: 0.5rem; }
  .a11y__sizebtns button { min-width: 2.75rem; min-height: 2.75rem; border: 1px solid #8a8174; background: #fff; color: inherit; border-radius: 6px; font: 600 1rem/1 inherit; cursor: pointer; }
  .a11y__sizebtns output { min-width: 3.2rem; text-align: center; font-variant-numeric: tabular-nums; }
  .a11y__list { list-style: none; margin: 0.75rem 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
  .a11y__opt {
    width: 100%; min-height: 3rem; padding: 0.5rem; border: 1px solid #8a8174; border-radius: 6px;
    background: #fff; color: inherit; font: 500 0.95rem/1.25 inherit; cursor: pointer;
  }
  .a11y__opt[aria-pressed='true'] { background: #1f4e8c; border-color: #1f4e8c; color: #fff; }
  .a11y__opt[aria-pressed='true']::before { content: '✓ '; }
  .a11y__foot { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-top: 0.6rem; border-top: 1px solid #e4ded3; }
  .a11y__reset { background: none; border: 0; padding: 0.4rem 0; color: inherit; text-decoration: underline; text-underline-offset: 0.25em; cursor: pointer; font: inherit; }
  .a11y__foot a { color: #1f4e8c; text-underline-offset: 0.25em; }
  .a11y button:focus-visible, .a11y a:focus-visible { outline: 3px solid #1f4e8c; outline-offset: 2px; }

  /* Phones: sit above the sticky questionnaire bar, opposite the WhatsApp button. */
  @media (max-width: 760px) {
    .a11y { inset-inline-end: 0.9rem; bottom: calc(5.25rem + env(safe-area-inset-bottom)); }
    .a11y__btn { width: 2.9rem; height: 2.9rem; }
  }
</style>

<script>
  const KEY = 'a11y-prefs';
  type Prefs = { size: number; contrast?: boolean; gray?: boolean; links?: boolean; spacing?: boolean; still?: boolean; cursor?: boolean };
  const SIZES = [1, 1.125, 1.25, 1.4];
  const root = document.documentElement;
  const read = (): Prefs => { try { return { size: 0, ...JSON.parse(localStorage.getItem(KEY) || '{}') }; } catch { return { size: 0 }; } };
  const write = (p: Prefs) => { try { localStorage.setItem(KEY, JSON.stringify(p)); } catch { /* private mode: applies for this page only */ } };

  const wrap = document.querySelector<HTMLElement>('[data-a11y]')!;
  const openBtn = wrap.querySelector<HTMLButtonElement>('[data-a11y-open]')!;
  const panel = wrap.querySelector<HTMLElement>('[data-a11y-panel]')!;
  const sizeVal = wrap.querySelector<HTMLOutputElement>('[data-a11y-size-val]')!;
  let prefs = read();

  function apply() {
    if (prefs.size > 0) root.style.setProperty('--a11y-fs', String(SIZES[prefs.size]));
    else root.style.removeProperty('--a11y-fs');
    for (const k of ['contrast', 'gray', 'links', 'spacing', 'still', 'cursor'] as const) {
      root.classList.toggle(`a11y-${k}`, !!prefs[k]);
      wrap.querySelector(`[data-a11y-toggle="${k}"]`)?.setAttribute('aria-pressed', String(!!prefs[k]));
    }
    sizeVal.value = `${Math.round((SIZES[prefs.size] ?? 1) * 100)}%`;
  }

  function setOpen(open: boolean) {
    panel.hidden = !open;
    openBtn.setAttribute('aria-expanded', String(open));
    if (open) panel.querySelector<HTMLElement>('button')?.focus();
  }

  openBtn.addEventListener('click', () => setOpen(panel.hidden));
  wrap.querySelector('[data-a11y-close]')!.addEventListener('click', () => { setOpen(false); openBtn.focus(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) { setOpen(false); openBtn.focus(); } });
  document.addEventListener('click', (e) => { if (!panel.hidden && !wrap.contains(e.target as Node)) setOpen(false); });

  wrap.querySelectorAll<HTMLButtonElement>('[data-a11y-size]').forEach((b) => b.addEventListener('click', () => {
    prefs.size = Math.min(SIZES.length - 1, Math.max(0, prefs.size + Number(b.dataset.a11ySize)));
    write(prefs); apply();
  }));
  wrap.querySelectorAll<HTMLButtonElement>('[data-a11y-toggle]').forEach((b) => b.addEventListener('click', () => {
    const k = b.dataset.a11yToggle as keyof Omit<Prefs, 'size'>;
    prefs[k] = !prefs[k];
    write(prefs); apply();
    // Scroll-driven motion (GSAP/Lenis) is set up once on load; restart the page to switch it.
    if (k === 'still' && document.querySelector('[data-hero]')) location.reload();
  }));
  wrap.querySelector('[data-a11y-reset]')!.addEventListener('click', () => {
    const hadStill = !!prefs.still;
    prefs = { size: 0 }; write(prefs); apply();
    if (hadStill && document.querySelector('[data-hero]')) location.reload();
  });

  apply();
</script>
