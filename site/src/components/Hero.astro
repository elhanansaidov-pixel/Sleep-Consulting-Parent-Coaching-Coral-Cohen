---
import { WHATSAPP_URL } from '../data/questionnaire';
// Draft film (480p) for review; final 1080p/720p encodes replace these paths after approval.
const hasVideo = true;
const videoDesktop = '/media/hero-draft.mp4';
const videoMobile = '/media/hero-draft.mp4';
---
<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero__stage">
    <picture class="hero__layer hero__layer--night">
      <source media="(max-width: 960px)" srcset="/media/night-960.webp" />
      <img src="/media/night-1920.webp" alt="" width="1920" height="1086" fetchpriority="high" decoding="async" />
    </picture>
    <picture class="hero__layer hero__layer--morning" data-hero-morning>
      <source media="(max-width: 960px)" srcset="/media/morning-960.webp" />
      <img src="/media/morning-1920.webp" alt="" width="1920" height="1086" loading="lazy" decoding="async" />
    </picture>
    {hasVideo && (
      <video class="hero__layer hero__video" data-hero-video muted playsinline preload="none" aria-hidden="true"
        data-src-desktop={videoDesktop} data-src-mobile={videoMobile}></video>
    )}
    <div class="hero__shade" aria-hidden="true"></div>

    <div class="hero__copy wrap">
      <p class="hero__eyebrow">ייעוץ שינה והדרכת הורים</p>
      <h1 id="hero-title" class="hero__title">
        לילות שקטים יותר מתחילים בתוכנית <em>שמתאימה בדיוק לכם</em>
      </h1>
      <p class="hero__sub">
        ליווי אישי וצמוד להורים, עם תוכנית שבנויה סביב הילד שלכם, השגרה שלכם והקצב של המשפחה.
      </p>
      <div class="hero__actions">
        <a class="btn btn--light" href="#questionnaire">לבדיקת התאמה</a>
        <a class="btn btn--light btn--ghost" href={WHATSAPP_URL} target="_blank" rel="noopener">או כתבו לי בוואטסאפ</a>
      </div>
      <p class="hero__micro">כ-5 דקות · ללא התחייבות</p>
    </div>

    <div class="hero__scroll" aria-hidden="true"><span></span></div>
  </div>
</section>

<style>
  .hero { position: relative; height: 260vh; background: var(--night); color: var(--cream); }
  .hero__stage { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; display: grid; align-items: center; }
  .hero__layer, .hero__layer img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 38% 60%; }
  .hero__layer--morning { opacity: 0; }
  .hero__video { opacity: 0; }
  .hero__shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(to left, rgba(20, 22, 32, 0.78) 0%, rgba(20, 22, 32, 0.45) 38%, rgba(20, 22, 32, 0) 70%),
      linear-gradient(to top, rgba(20, 22, 32, 0.55), rgba(20, 22, 32, 0) 40%);
  }
  .hero__copy { position: relative; z-index: 2; padding-top: 4rem; }
  .hero__copy > * { max-width: 34rem; }
  .hero__copy > .hero__title { max-width: 44rem; }
  .hero__eyebrow { font-weight: 600; letter-spacing: 0.14em; font-size: var(--step--1); color: var(--sand); display: flex; gap: 0.7em; align-items: center; }
  .hero__eyebrow::before { content: ''; width: 2.4rem; height: 1px; background: currentColor; }
  .hero__title { font-size: min(var(--step-4), 4.6rem); font-weight: 400; margin-bottom: 0.4em; }
  .hero__title em { font-style: normal; color: var(--sand); }
  .hero__sub { font-size: var(--step-1); line-height: 1.55; color: rgba(254, 250, 244, 0.86); max-width: 30rem; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; }
  .hero__micro { margin-top: 1rem; font-size: var(--step--1); color: rgba(254, 250, 244, 0.7); }
  .hero__scroll { position: absolute; bottom: 1.6rem; inset-inline: 0; margin-inline: auto; width: 1px; height: 3.2rem; background: rgba(254, 250, 244, 0.25); overflow: hidden; }
  .hero__scroll span { display: block; width: 100%; height: 40%; background: var(--cream); animation: drip 2.4s var(--ease) infinite; }
  @keyframes drip { 0% { transform: translateY(-100%); } 100% { transform: translateY(260%); } }

  @media (max-width: 760px) {
    .hero { height: 220vh; }
    .hero__stage { align-items: end; }
    .hero__layer, .hero__layer img { object-position: 46% 50%; }
    .hero__shade { background: linear-gradient(to top, rgba(20, 22, 32, 0.92) 0%, rgba(20, 22, 32, 0.6) 45%, rgba(20, 22, 32, 0.1) 75%); }
    .hero__copy { padding-bottom: 5.5rem; }
    .hero__actions .btn { flex: 1 1 100%; }
    .hero__eyebrow { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero { height: auto; }
    .hero__stage { position: relative; }
    .hero__scroll { display: none; }
  }
</style>
