---
/** Header, footer, floating WhatsApp and the mobile sticky CTA. Use with slot="header" / default for footer. */
import { WHATSAPP_URL } from '../data/questionnaire';
interface Props { part: 'header' | 'footer'; }
const { part } = Astro.props;
const year = new Date().getFullYear();
---
{part === 'header' && (
  <header class="topbar" data-topbar>
    <div class="wrap topbar__in">
      <a class="topbar__brand" href="/" aria-label="קורל כהן — ייעוץ שינה והדרכת הורים, לעמוד הבית">
        <span class="topbar__name">coral cohen</span>
        <span class="topbar__tag">ייעוץ שינה | הדרכת הורים</span>
      </a>
      <nav aria-label="ניווט ראשי" class="topbar__nav">
        <a href="#about">על קורל</a>
        <a href="#process">התהליך</a>
        <a class="topbar__cta" href="#questionnaire">לבדיקת התאמה</a>
      </nav>
    </div>
  </header>
)}

{part === 'footer' && (
  <>
    <footer class="footer">
      <div class="wrap footer__in">
        <div>
          <p class="footer__name">coral cohen</p>
          <p class="footer__tag">קורל כהן | ייעוץ שינה והדרכת הורים</p>
        </div>
        <nav aria-label="קישורים בתחתית העמוד" class="footer__links">
          <a href="/#questionnaire">שאלון התאמה</a>
          <a href={WHATSAPP_URL} target="_blank" rel="noopener">וואטסאפ</a>
          <a href="/privacy">מדיניות פרטיות</a>
          <a href="/accessibility">הצהרת נגישות</a>
        </nav>
        <p class="footer__note">המידע באתר ובתהליך הוא כללי ואינו מהווה ייעוץ, אבחון או טיפול רפואי. בכל שאלה רפואית יש לפנות לרופא/ת הילדים.</p>
        <p class="footer__copy">© {year} קורל כהן. כל הזכויות שמורות.</p>
      </div>
    </footer>

    <a class="wa" href={WHATSAPP_URL} target="_blank" rel="noopener" aria-label="שיחה בוואטסאפ עם קורל">
      <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3Zm0 23.7c-2 0-4-.5-5.6-1.5l-.4-.2-3.9 1 1-3.8-.3-.4A10.7 10.7 0 1 1 16 26.7Zm5.9-8c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1a8.8 8.8 0 0 1-4.4-3.8c-.3-.6.3-.5 1-1.7.1-.2 0-.4 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.1 1.1-1.1 2.7s1.2 3.1 1.3 3.3c.2.2 2.3 3.5 5.5 4.9 2 .9 2.8 1 3.8.8.6-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5-.1-.2-.3-.2-.7-.4Z"/></svg>
    </a>

    <div class="mcta" data-mcta>
      <a class="btn" href="#questionnaire">לבדיקת התאמה <small>· כ-5 דקות</small></a>
    </div>
  </>
)}

<style>
  .topbar { position: fixed; inset-inline: 0; top: 0; z-index: 50; color: var(--cream); transition: background 0.4s, color 0.4s, box-shadow 0.4s; }
  .topbar.is-solid { background: rgba(254, 250, 244, 0.92); color: var(--ink); backdrop-filter: blur(10px); box-shadow: 0 1px 0 var(--line); }
  .topbar__in { display: flex; align-items: center; justify-content: space-between; min-height: 4.25rem; }
  .topbar__brand { text-decoration: none; display: grid; line-height: 1.1; }
  .topbar__name { font-family: var(--font-display); font-weight: 400; font-size: 1.3rem; letter-spacing: 0.02em; direction: ltr; text-align: right; }
  .topbar__tag { font-size: 0.8rem; opacity: 0.8; }
  .topbar__nav { display: flex; gap: 1.6rem; align-items: center; font-weight: 500; font-size: 0.98rem; }
  .topbar__nav a { text-decoration: none; }
  .topbar__cta { border: 1px solid currentColor; border-radius: 999px; padding: 0.55rem 1.2rem; }
  @media (max-width: 760px) { .topbar__nav a:not(.topbar__cta) { display: none; } .topbar__cta { display: none; } }

  .footer { background: var(--night); color: rgba(254, 250, 244, 0.85); padding-block: var(--space-l) calc(var(--space-m) + 5rem); }
  .footer__in { display: grid; gap: 1.5rem; }
  .footer__name { font-family: var(--font-display); font-size: var(--step-2); color: var(--cream); margin: 0; direction: ltr; text-align: right; }
  .footer__tag { margin: 0; color: var(--sand); }
  .footer__links { display: flex; flex-wrap: wrap; gap: 0.75rem 1.75rem; }
  .footer__links a { text-underline-offset: 0.3em; }
  .footer__note, .footer__copy { font-size: var(--step--1); color: rgba(254, 250, 244, 0.65); margin: 0; max-width: 46rem; }

  .wa {
    position: fixed; z-index: 60; inset-inline-start: 1.1rem; bottom: 1.1rem;
    width: 3.5rem; height: 3.5rem; border-radius: 50%; display: grid; place-items: center;
    background: var(--ink); color: var(--cream); box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.45);
    transition: transform 0.4s var(--ease);
  }
  .wa:hover { transform: scale(1.06); }

  .mcta { display: none; }
  @media (max-width: 760px) {
    .mcta {
      display: block; position: fixed; z-index: 55; bottom: 0; inset-inline: 0;
      padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom)) 5rem;
      background: linear-gradient(to top, rgba(254, 250, 244, 0.98) 60%, rgba(254, 250, 244, 0));
      transform: translateY(110%); transition: transform 0.5s var(--ease);
    }
    .mcta.is-on { transform: none; }
    .mcta .btn { width: 100%; }
    .mcta small { font-weight: 400; opacity: 0.8; }
    .wa { bottom: 0.95rem; inset-inline-start: 0.9rem; z-index: 56; }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-topbar]');
  const mcta = document.querySelector<HTMLElement>('[data-mcta]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const q = document.querySelector<HTMLElement>('#questionnaire');
  let qVisible = false;
  if (q) new IntersectionObserver(([e]) => { qVisible = e.isIntersecting; update(); }, { threshold: 0.05 }).observe(q);
  function update() {
    const pastHero = hero ? hero.getBoundingClientRect().bottom < 80 : true;
    bar?.classList.toggle('is-solid', pastHero);
    mcta?.classList.toggle('is-on', window.scrollY > window.innerHeight * 0.6 && !qVisible);
  }
  addEventListener('scroll', update, { passive: true });
  update();
</script>
